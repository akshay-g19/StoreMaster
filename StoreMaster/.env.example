SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/storemaster_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_INITIALIZATION_FAIL_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT=5000

SPRING_DOCKER_COMPOSE_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=false

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS=always

LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
TZ=Asia/Kolkata
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Kolkata -XX:MaxRAMPercentage=75.0
